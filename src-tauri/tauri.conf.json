{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipVault",
  "version": "1.0.2",
  "identifier": "com.clipvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipVault",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": false,
        "theme": "Dark"
      },
      {
        "label": "picker",
        "title": "ClipVault Picker",
        "url": "index.html?picker=1",
        "width": 580,
        "height": 452,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "ClipVault",
    "copyright": "© 2026 ClipVault",
    "category": "Utility",
    "shortDescription": "A permanent, local-first clipboard archive for Windows.",
    "longDescription": "ClipVault keeps everything you copy — text, links, images, files and registered clipboard formats — in a local SQLite archive with full-text search. Nothing expires and nothing leaves your PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
